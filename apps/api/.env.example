# Database
DATABASE_URL="postgresql://user:password@localhost:5432/labamu_ims"

# Server
PORT=3001
NODE_ENV=development

# Security — REQUIRED in production, app will refuse to start without these
JWT_SECRET=change-me-use-a-long-random-string-minimum-32-chars
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Lalamove shipping integration (optional)
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com

# Error log directory (optional, defaults to <cwd>/logs)
LOG_DIR=

# Email / SMTP (optional — email dispatch is disabled when not set)
# Use AWS SES SMTP endpoint for production, or any SMTP relay for dev/staging.
# Example: mailhog for local dev (npm install -g mailhog)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Labamu IMS <noreply@labamu.app>
