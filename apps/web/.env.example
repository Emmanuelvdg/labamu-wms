# Internal API base URL — server-side Next.js → NestJS (not exposed to browser)
# In production: set to the internal service URL (e.g. http://api:3001)
API_URL=http://127.0.0.1:3001

# Public API URL used in client-side fetch and next.config.ts rewrite destination
# In production: set to the public-facing API hostname
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

NODE_ENV=development
