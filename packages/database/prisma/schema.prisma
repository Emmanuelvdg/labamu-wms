generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MULTI-TENANCY ───────────────────────────────────────────────────────────
// Every top-level entity (Product, Warehouse, Supplier, Customer, Role, User)
// carries a companyId that scopes it to a single tenant. Warehouse already had
// an unused companyId field; all others are added here.
model Company {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique   // used for subdomain routing (e.g. "acme")
  plan      String     @default("STARTER")   // FREE | STARTER | PROFESSIONAL | ENTERPRISE
  status    String     @default("ACTIVE")    // ACTIVE | SUSPENDED | CANCELLED
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  users                 User[]
  warehouses            Warehouse[]
  products              Product[]
  suppliers             Supplier[]
  customers             Customer[]
  roles                 Role[]
  tenantPlan            TenantPlan?
  featureFlags          FeatureFlag[]
  auditLogs             AuditLog[]
  notificationConfigs   CompanyNotificationConfig[]
}

// ── Platform admin models ─────────────────────────────────────────────────────

model TenantPlan {
  id                 String    @id @default(uuid())
  companyId          String    @unique
  billingCycle       String    @default("MONTHLY")  // MONTHLY | ANNUAL | LIFETIME
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  maxUsers           Int?      // null = use plan default
  maxWarehouses      Int?
  maxProducts        Int?
  maxOrders          Int?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id])
}

model FeatureFlag {
  id        String   @id @default(uuid())
  companyId String
  key       String
  enabled   Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actorEmail  String
  action      String   // TENANT_CREATE | TENANT_UPDATE | STATUS_CHANGE | PLAN_UPDATE | IMPERSONATE | FLAG_TOGGLE | ANNOUNCE
  targetType  String   // COMPANY | USER
  targetId    String
  targetLabel String
  metadata    String?  // JSON blob
  createdAt   DateTime @default(now())
  company     Company? @relation(fields: [targetId], references: [id])

  @@index([targetId])
  @@index([createdAt])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  targetType  String    @default("ALL")  // ALL | PLAN | COMPANY
  targetValue String?   // plan name or companyId
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
// ─────────────────────────────────────────────────────────────────────────────

model Product {
  id                   String                       @id @default(uuid())
  sku                  String                       @unique
  name                 String
  category             String
  classification       String?
  type                 String?
  unitOfMeasure        String?
  isStockable          Boolean                      @default(true)
  status               String                       @default("Active")
  averageCost          Float                        @default(0)
  price                Float                        @default(0)
  description          String?
  tracking             String                       @default("none")
  expiryDate           DateTime?
  width                Float?
  height               Float?
  depth                Float?
  weight               Float?
  velocity             String?                      @default("C")
  abcClass             String?
  temperatureMin       Float?
  temperatureMax       Float?
  preferredPackaging   String?
  stackable            Boolean                      @default(true)
  maxStackHeight       Int?
  supplierId           String?
  safetyStock          Int?
  reorderPoint         Int?
  reorderQuantity      Int?
  maxStock             Int?
  requiredAttributeId  String?
  companyId            String?
  inventoryAdjustments InventoryAdjustment[]
  batches              InventoryBatch[]
  orderItems           OrderItem[]
  pickingTasks         PickingTask[]
  requiredAttribute    LocationAttributeDefinition? @relation(fields: [requiredAttributeId], references: [id])
  attributes           ProductAttribute[]
  inventory            ProductInventory[]
  packaging            ProductPackaging[]
  purchaseOrderItems   PurchaseOrderItem[]
  putawayRules         PutawayRule[]
  putawayTasks         PutawayTask[]
  qaInspectionResults  QaInspectionResult[]
  receiptItems         ReceiptItem[]
  reorderingRules      ReorderingRule[]
  reservations         Reservation[]
  rotationRules        RotationRule[]
  scrapOrders          ScrapOrder[]
  stockMoves           StockMove[]
  transactions         StockTransaction[]
  stocktakeTasks       StocktakeTask[]
  TransferOrderItem    TransferOrderItem[]
  packageItems         PackingParcelItem[]
  replenishmentAlerts  ReplenishmentAlert[]
  routes               Route[]                      @relation("ProductToRoute")
  asnItems             AsnItem[]
  company              Company?                     @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([status])
  @@index([supplierId])
}

model Route {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  rules       Rule[]
  products    Product[] @relation("ProductToRoute")
}

model Rule {
  id                    String      @id @default(uuid())
  routeId               String
  action                String
  sourceLocationId      String?
  destinationLocationId String?
  sequence              Int         @default(0)
  conditions            String?     // JSON condition blob — same format as WorkflowTransition.condition
  triggerType           String?     // 'INBOUND' | 'OUTBOUND' | null (matches any)
  destinationLocation   Location?   @relation("DestLocation", fields: [destinationLocationId], references: [id])
  sourceLocation        Location?   @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  route                 Route       @relation(fields: [routeId], references: [id])
  stockMoves            StockMove[]
}

model Warehouse {
  id                     String                    @id @default(uuid())
  name                   String
  shortName              String?
  status                 String                    @default("Enabled")
  length                 Float?                    @default(0)
  width                  Float?                    @default(0)
  height                 Float?                    @default(0)
  maxWeight              Float?                    @default(0)
  address                String?
  city                   String?
  state                  String?
  postalCode             String?
  country                String?
  phone                  String?
  latitude               Float?
  longitude              Float?
  companyId              String?
  company                Company?                  @relation(fields: [companyId], references: [id])
  location               String                    @default("{}")
  type                   String
  workflowTemplates      WorkflowTemplate[]
  workflowInstances      WorkflowInstance[]
  partnerId              String?
  viewLocationId         String?                   @unique
  incomingSteps          String?
  outgoingSteps          String?
  dropshipSubcontractors Boolean                   @default(false)
  resupplySubcontractors Boolean                   @default(false)
  manufactureToResupply  Boolean                   @default(false)
  manufactureSteps       String?
  buyToResupply          Boolean                   @default(false)
  floorPlanShape         String?                   @default("rectangle")
  floorPlanVertices      String?
  floorPlanWidth         Float?                    @default(50.0)
  floorPlanHeight        Float?                    @default(30.0)
  gridEnabled            Boolean                   @default(true)
  gridSize               Float                     @default(1.0)
  snapToGrid             Boolean                   @default(true)
  autoReplenishmentEnabled  Boolean               @default(false)
  requireWeightVerification Boolean               @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @default(now()) @updatedAt
  fulfillmentRules       FulfillmentRule[]
  batches                InventoryBatch[]
  lalamoveConfig         LalamoveConfig?
  transferDestOrders     Order[]                   @relation("OrderDestination")
  orders                 Order[]
  pickingSessions        PickingSession[]
  pickingStrategies      PickingStrategy[]
  inventory              ProductInventory[]
  putawayRules           PutawayRule[]
  putawaySessions        PutawaySession[]
  rotationRules          RotationRule[]
  stocktakeSessions      StocktakeSession[]
  destTransfers          TransferOrder[]           @relation("TransferDest")
  sourceTransfers        TransferOrder[]           @relation("TransferSource")
  viewLocation           Location?                 @relation("WarehouseView", fields: [viewLocationId], references: [id])
  functionalAreas        WarehouseFunctionalArea[]
  users                  User[]                    @relation("UserToWarehouse")
  replenishmentAlerts    ReplenishmentAlert[]
  waveReleaseRules       WaveReleaseRule[]
}

model WarehouseFunctionalArea {
  id               String     @id @default(uuid())
  warehouseId      String
  name             String
  areaType         String
  shapeType        String?    @default("rectangle")
  vertices         String?
  x                Float      @default(0)
  y                Float      @default(0)
  width            Float      @default(100)
  height           Float      @default(100)
  rotation         Float      @default(0)
  color            String?
  icon             String?
  attributes       String?
  active           Boolean    @default(true)
  sequence         Int        @default(0)
  linkedLocationId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  linkedLocation   Location?  @relation(fields: [linkedLocationId], references: [id])
  warehouse        Warehouse  @relation(fields: [warehouseId], references: [id])
  locations        Location[] @relation("AreaLocations")
}

model Location {
  id                      String                    @id @default(uuid())
  name                    String
  type                    String
  structuralType          String?
  attributes              String?
  supportedPackaging      String?
  removalStrategy         String?
  inventoryFrequency      Int                       @default(0)
  nextInventoryDate       DateTime?
  maxVolume               Float?
  maxWeight               Float?
  x                       Float?                    @default(0)
  y                       Float?                    @default(0)
  width                   Float?                    @default(1)
  height                  Float?                    @default(1)
  rotation                Float?                    @default(0)
  zonePriority            Int                       @default(100)
  putawaySequence         Int                       @default(0)
  parentId                String?
  warehouseId             String?
  functionalAreaId        String?
  code                    String?
  fullAddress             String?                   @unique
  innerHeight             Float?                    @default(0)
  innerLength             Float?                    @default(0)
  innerWidth              Float?                    @default(0)
  maxWeightKg             Float?                    @default(0)
  adjustments             InventoryAdjustment[]
  batches                 InventoryBatch[]
  parent                  Location?                 @relation("LocationHierarchy", fields: [parentId], references: [id])
  children                Location[]                @relation("LocationHierarchy")
  dynamicAttributes       LocationAttribute[]
  packages                Package[]
  pickingTasks            PickingTask[]
  inventory               ProductInventory[]
  putawayRules            PutawayRule[]
  putawayDestinationRules PutawayRule[]             @relation("PutawayDest")
  sourcePutawayRules      PutawayRule[]             @relation("PutawaySource")
  putawayDestTasks        PutawayTask[]             @relation("PutawayDest")
  putawaySourceTasks      PutawayTask[]             @relation("PutawaySource")
  receipts                Receipt[]
  reorderingRules         ReorderingRule[]
  destRules               Rule[]                    @relation("DestLocation")
  sourceRules             Rule[]                    @relation("SourceLocation")
  scrapOrders             ScrapOrder[]
  destMoves               StockMove[]               @relation("MoveDest")
  sourceMoves             StockMove[]               @relation("MoveSource")
  stocktakeTasks          StocktakeTask[]
  warehouseView           Warehouse?                @relation("WarehouseView")
  functionalAreas         WarehouseFunctionalArea[]
  functionalArea          WarehouseFunctionalArea?  @relation("AreaLocations", fields: [functionalAreaId], references: [id])

  @@index([parentId])
  @@index([warehouseId])
}

model ProductPackaging {
  id                  String              @id @default(uuid())
  name                String
  unitType            String              @default("UNIT")
  quantity            Int                 @default(1)
  width               Float               @default(0)
  height              Float               @default(0)
  length              Float               @default(0)
  weight              Float               @default(0)
  ti                  Int                 @default(0)
  hi                  Int                 @default(0)
  barcode             String?
  storageRequirements String?
  maxStacking         Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  productId           String?
  packages            Package[]
  Product             Product?            @relation(fields: [productId], references: [id])
  purchaseOrderItems  PurchaseOrderItem[]
}

model ProductInventory {
  id          String    @id @default(uuid())
  productId   String
  warehouseId String
  locationId  String?
  quantity    Int
  reserved    Int       @default(0)
  location    Location? @relation(fields: [locationId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@index([productId, warehouseId])
}

model InventoryBatch {
  id              String                @id @default(uuid())
  batchNumber     String                @unique
  productId       String
  warehouseId     String
  locationId      String?
  packageId       String?
  initialQuantity Int
  currentQuantity Int
  reserved        Int                   @default(0)
  costPerUnit     Float
  purchaseDate    DateTime
  expiryDate      DateTime?
  status          String
  vendor          String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  adjustments     InventoryAdjustment[]
  package         Package?              @relation(fields: [packageId], references: [id])
  location        Location?             @relation(fields: [locationId], references: [id])
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])
  product         Product               @relation(fields: [productId], references: [id])
  stockMoves      StockMove[]

  @@index([productId, warehouseId])
  @@index([status])
  @@index([expiryDate])
}

model Package {
  id          String            @id @default(uuid())
  name        String            @unique
  type        String
  huType      String            @default("BOX")
  outerLength Float?            @default(0)
  outerWidth  Float?            @default(0)
  outerHeight Float?            @default(0)
  tareWeight  Float?            @default(0)
  packagingId String?
  locationId  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  batches     InventoryBatch[]
  location    Location?         @relation(fields: [locationId], references: [id])
  packaging   ProductPackaging? @relation(fields: [packagingId], references: [id])
}

model StockTransaction {
  id          String   @id @default(uuid())
  productId   String
  batchId     String?
  type        String
  quantity    Int
  date        DateTime @default(now())
  referenceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id])

  @@index([productId, date])
}

model Order {
  id                     String             @id @default(uuid())
  customerId             String?
  status                 String
  fulfillmentStatus      String             @default("UNALLOCATED")
  priority               String
  shippingCarrier        String?
  expectedDate           DateTime?
  warehouseId            String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  totalAmount            Float              @default(0)
  currencyCode           String             @default("IDR")
  type                   String             @default("SALES")
  destinationWarehouseId String?
  parentOrderId          String?
  deliveryMethodId       String?
  shippingCost           Float              @default(0)
  shippingCostInCOGS     Boolean            @default(false)
  lalamoveOrders         LalamoveOrder[]
  deliveryMethod         DeliveryMethod?    @relation(fields: [deliveryMethodId], references: [id])
  parentOrder            Order?             @relation("OrderHierarchy", fields: [parentOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childOrders            Order[]            @relation("OrderHierarchy")
  destinationWarehouse   Warehouse?         @relation("OrderDestination", fields: [destinationWarehouseId], references: [id])
  warehouse              Warehouse?         @relation(fields: [warehouseId], references: [id])
  customer               Customer?          @relation(fields: [customerId], references: [id])
  items                  OrderItem[]
  pickingTasks           PickingTask[]
  reservations           Reservation[]
  shipment               Shipment?
  packingSession         PackingSession?
  transferOrders         TransferOrder[]

  @@index([status])
  @@index([customerId])
  @@index([warehouseId])
  @@index([createdAt])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  condition    String?
  returnReason String?
  product      Product @relation(fields: [productId], references: [id])
  order        Order   @relation(fields: [orderId], references: [id])
}

model Reservation {
  id                  String   @id @default(uuid())
  productId           String
  orderId             String
  quantity            Int
  reservationStrategy String
  createdAt           DateTime @default(now())
  order               Order    @relation(fields: [orderId], references: [id])
  product             Product  @relation(fields: [productId], references: [id])
}

model PickingStrategy {
  id          String     @id @default(uuid())
  name        String
  rules       String
  active      Boolean    @default(true)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, name])
}

model PickingSession {
  id          String        @id @default(uuid())
  warehouseId String
  strategy    String
  status      String        @default("PLANNED")
  pickerId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  picker      User?         @relation(fields: [pickerId], references: [id])
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  tasks       PickingTask[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LocationAttributeDefinition {
  id                    String                 @id @default(uuid())
  name                  String                 @unique
  type                  String
  options               String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  locationAttributes    LocationAttribute[]    @relation("LocationAttributes")
  Product               Product[]
  productAttributes     ProductAttribute[]     @relation("ProductAttributes")
  putawayRuleAttributes PutawayRuleAttribute[] @relation("PutawayRuleAttributes")
}

model PickingTask {
  id               String         @id @default(uuid())
  sessionId        String
  orderId          String
  productId        String
  sourceLocationId String
  quantity         Int
  pickedQuantity   Int            @default(0)
  status           String         @default("PENDING")
  exceptionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  sourceLocation   Location       @relation(fields: [sourceLocationId], references: [id])
  product          Product        @relation(fields: [productId], references: [id])
  order            Order          @relation(fields: [orderId], references: [id])
  session          PickingSession @relation(fields: [sessionId], references: [id])
}

model PutawaySession {
  id          String        @id @default(uuid())
  warehouseId String
  status      String        @default("PLANNED")
  workerId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  worker      User?         @relation(fields: [workerId], references: [id])
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  tasks       PutawayTask[]
}

model PutawayTask {
  id                       String          @id @default(uuid())
  sessionId                String?
  receiptId                String?
  productId                String
  sourceLocationId         String
  destinationLocationId    String
  quantity                 Int
  putawayQuantity          Int             @default(0)
  status                   String          @default("PENDING")
  exceptionType            String?
  exceptionReason          String?
  originalQuantity         Int?
  actualQuantity           Int?
  alternativeLocationId    String?
  requiresSupervisorReview Boolean         @default(false)
  resolvedBy               String?
  resolvedAt               DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  destinationLocation      Location        @relation("PutawayDest", fields: [destinationLocationId], references: [id])
  sourceLocation           Location        @relation("PutawaySource", fields: [sourceLocationId], references: [id])
  product                  Product         @relation(fields: [productId], references: [id])
  receipt                  Receipt?        @relation(fields: [receiptId], references: [id])
  session                  PutawaySession? @relation(fields: [sessionId], references: [id])
}

model ReservationStrategy {
  id     String  @id @default(uuid())
  name   String  @unique
  rules  String
  active Boolean @default(true)
}

model Shipment {
  id         String @id @default(uuid())
  orderId    String @unique
  carrier    String
  trackingId String
  status     String
  order      Order  @relation(fields: [orderId], references: [id])
}

model ComplianceReport {
  id        String   @id @default(uuid())
  type      String
  period    String
  data      String
  createdAt DateTime @default(now())
}

model SalesChannel {
  id     String @id @default(uuid())
  name   String @unique
  apiKey String
}

model LogisticsPartner {
  id        String @id @default(uuid())
  name      String @unique
  apiConfig String
}

model InventoryAdjustment {
  id              String          @id @default(uuid())
  locationId      String
  productId       String
  batchId         String?
  countedQuantity Int             @default(0)
  currentQuantity Int             @default(0)
  quantity        Int
  reason          String
  status          String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  batch           InventoryBatch? @relation(fields: [batchId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])
  location        Location        @relation(fields: [locationId], references: [id])
}

model ScrapOrder {
  id          String   @id @default(uuid())
  locationId  String
  productId   String
  quantity    Int
  maxQuantity Int
  active      Boolean  @default(true)
  product     Product  @relation(fields: [productId], references: [id])
  location    Location @relation(fields: [locationId], references: [id])
}

model ReorderingRule {
  id          String   @id @default(uuid())
  productId   String
  locationId  String
  minQuantity Int
  maxQuantity Int
  active      Boolean  @default(true)
  location    Location @relation(fields: [locationId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model PutawayRule {
  id                       String                 @id @default(uuid())
  name                     String
  description              String?
  productId                String?
  categoryId               String?
  velocityClass            String?
  abcClass                 String?
  minPackagingSize         String?
  maxPackagingSize         String?
  minWeight                Float?
  maxWeight                Float?
  sourceLocationId         String?
  strategy                 String
  destinationLocationId    String?
  preferredZonePriorityMin Int?
  preferredZonePriorityMax Int?
  warehouseId              String?
  locationId               String?
  priority                 Int                    @default(0)
  active                   Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  location                 Location?              @relation(fields: [locationId], references: [id])
  warehouse                Warehouse?             @relation(fields: [warehouseId], references: [id])
  destinationLocation      Location?              @relation("PutawayDest", fields: [destinationLocationId], references: [id])
  sourceLocation           Location?              @relation("PutawaySource", fields: [sourceLocationId], references: [id])
  product                  Product?               @relation(fields: [productId], references: [id])
  requiredAttributes       PutawayRuleAttribute[]
}

model PutawayRuleAttribute {
  id                    String                      @id @default(uuid())
  putawayRuleId         String
  attributeDefinitionId String
  requiredValue         String?
  createdAt             DateTime                    @default(now())
  attributeDefinition   LocationAttributeDefinition @relation("PutawayRuleAttributes", fields: [attributeDefinitionId], references: [id])
  putawayRule           PutawayRule                 @relation(fields: [putawayRuleId], references: [id], onDelete: Cascade)

  @@unique([putawayRuleId, attributeDefinitionId])
}

model ProductAttribute {
  id                    String                      @id @default(uuid())
  productId             String
  attributeDefinitionId String
  value                 String?
  createdAt             DateTime                    @default(now())
  attributeDefinition   LocationAttributeDefinition @relation("ProductAttributes", fields: [attributeDefinitionId], references: [id])
  product               Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeDefinitionId])
}

model LocationAttribute {
  id           String                      @id @default(uuid())
  locationId   String
  definitionId String
  value        String?
  createdAt    DateTime                    @default(now())
  definition   LocationAttributeDefinition @relation("LocationAttributes", fields: [definitionId], references: [id])
  location     Location                    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, definitionId])
}

model Supplier {
  id             String              @id @default(uuid())
  name           String
  contactInfo    String?
  email          String?
  phone          String?
  address        String?
  companyId      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  invoices       Invoice[]
  purchaseOrders PurchaseOrder[]
  company        Company?            @relation(fields: [companyId], references: [id])
  supplierUsers  SupplierUser[]
  invitations    SupplierInvitation[]

  @@unique([name, companyId])
}

model PurchaseOrder {
  id              String               @id @default(uuid())
  poNumber        String               @unique @default(cuid())
  supplierId      String
  status          String               @default("DRAFT")
  approvalStatus  String               @default("DRAFT")
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  asnNumber       String?
  asnExpectedDate DateTime?
  threeWayMatch   String               @default("PENDING")
  orderDate       DateTime             @default(now())
  expectedDate    DateTime?
  buyerName       String?
  buyerAddress    String?
  buyerContact    String?
  shipToAddress   String?
  billToAddress   String?
  taxAmount       Float                @default(0)
  shippingCost    Float                @default(0)
  totalAmount     Float                @default(0)
  currencyCode    String               @default("IDR")
  paymentTerms    String?
