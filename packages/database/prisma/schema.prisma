generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id              String   @id @default(uuid())
  sku             String   @unique
  name            String
  category        String
  classification  String?  // ABC Classification: A, B, C
  type            String?  // Raw, Finished, Semi-finished
  unitOfMeasure   String?  // Centimeter, Piece, etc.
  isStockable     Boolean  @default(true)
  status          String   @default("Active")
  averageCost     Float    @default(0)
  description     String?
  tracking        String   @default("none") // none, lot, serial
  expiryDate      DateTime? // Keep for legacy/simple use, but Batches are preferred
  // Dimensions & Weight
  width           Float?   // cm
  height          Float?   // cm
  depth           Float?   // cm
  weight          Float?   // kg
  
  supplierId      String?
  inventory       ProductInventory[] // Aggregate view
  batches         InventoryBatch[]   // Detailed view
  orderItems      OrderItem[]
  reservations    Reservation[]
  transactions    StockTransaction[]
  putawayRules    PutawayRule[]
  inventoryAdjustments InventoryAdjustment[]
  scrapOrders     ScrapOrder[]
  reorderingRules ReorderingRule[]
  routes          Route[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMoves      StockMove[]
  packaging       ProductPackaging[]
  pickingTasks    PickingTask[]
}

model Route {
  id          String   @id @default(uuid())
  name        String
  description String?
  rules       Rule[]
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Rule {
  id                  String   @id @default(uuid())
  routeId             String
  route               Route    @relation(fields: [routeId], references: [id])
  action              String   // PULL, PUSH
  sourceLocationId    String?
  sourceLocation      Location? @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocationId String?
  destinationLocation Location? @relation("DestLocation", fields: [destinationLocationId], references: [id])
  sequence            Int      @default(0)
  stockMoves          StockMove[]
}

model Warehouse {
  id             String   @id @default(uuid())
  name           String
  shortName      String?  // Max 5 chars
  address        String?
  companyId      String?
  location       String   // JSON: { lat: number, lng: number }
  type           String
  partnerId      String?
  viewLocationId String?  @unique
  viewLocation   Location? @relation("WarehouseView", fields: [viewLocationId], references: [id])
  
  // Route Configuration
  incomingSteps         String? // "1_step", "2_steps", "3_steps"
  outgoingSteps         String? // "1_step", "2_steps", "3_steps"
  dropshipSubcontractors Boolean @default(false)
  resupplySubcontractors Boolean @default(false)
  manufactureToResupply  Boolean @default(false)
  manufactureSteps       String? // "1_step", "2_steps", "3_steps"
  buyToResupply          Boolean @default(false)
  
  inventory      ProductInventory[]
  batches        InventoryBatch[]
  pickingStrategies PickingStrategy[]
  orders         Order[]
  pickingSessions PickingSession[]
}

model Location {
  id          String   @id @default(uuid())
  name        String
  type        String   // VIEW, INTERNAL, VENDOR, CUSTOMER, INVENTORY_LOSS, PRODUCTION, TRANSIT
  structuralType String? // WAREHOUSE, ROOM, ROW, BAY, SHELF, POSITION
  attributes  String?  // JSON: { temperature: 'refrigerated', loadBearing: true, ... }
  removalStrategy String? // FIFO, LIFO, FEFO
  inventoryFrequency Int @default(0) // Days
  nextInventoryDate DateTime?
  
  // Capacity
  maxVolume   Float?   // m3
  maxWeight   Float?   // kg

  // Floor Plan Coordinates (for Bays)
  x           Float?   @default(0)
  y           Float?   @default(0)
  width       Float?   @default(1)
  height      Float?   @default(1)
  rotation    Float?   @default(0)
  
  parentId    String?
  parent      Location? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children    Location[] @relation("LocationHierarchy")
  warehouseId String?
  warehouseView Warehouse? @relation("WarehouseView")
  
  // Relations
  inventory   ProductInventory[]
  batches     InventoryBatch[]
  adjustments InventoryAdjustment[]
  scrapOrders ScrapOrder[]
  putawayRules PutawayRule[]
  sourcePutawayRules PutawayRule[] @relation("PutawaySource")
  reorderingRules ReorderingRule[]
  sourceRules     Rule[] @relation("SourceLocation")
  destRules       Rule[] @relation("DestLocation")
  packages        Package[]
  receipts        Receipt[]
  sourceMoves     StockMove[] @relation("MoveSource")
  destMoves       StockMove[] @relation("MoveDest")
  pickingTasks    PickingTask[]
}

model ProductPackaging {
  id          String   @id @default(uuid())
  name        String   // e.g. "Box of 12", "Pallet"
  type        String   // BOX, PALLET, UNIT
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int      // Quantity of base units
  
  // Dimensions & Weight
  width       Float?   // cm
  height      Float?   // cm
  depth       Float?   // cm
  weight      Float?   // kg
  
  barcode     String?
  
  packages    Package[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Aggregate Inventory (Legacy/Fast Lookup)
model ProductInventory {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  quantity    Int
  reserved    Int      @default(0)
}

model InventoryBatch {
  id              String   @id @default(uuid())
  batchNumber     String   @unique
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  warehouseId     String
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id])
  locationId      String?
  location        Location? @relation(fields: [locationId], references: [id])
  packageId       String?
  package         Package? @relation(fields: [packageId], references: [id])
  initialQuantity Int
  currentQuantity Int
  costPerUnit     Float
  purchaseDate    DateTime
  expiryDate      DateTime?
  status          String   // Active, Expired, Depleted
  vendor          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  adjustments     InventoryAdjustment[]
  stockMoves      StockMove[]
}

model Package {
  id          String   @id @default(uuid())
  name        String   @unique // Barcode / LPN
  type        String   // Box, Pallet, etc. (Legacy/Simple)
  packagingId String?
  packaging   ProductPackaging? @relation(fields: [packagingId], references: [id])
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  batches     InventoryBatch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockTransaction {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  batchId     String?
  type        String   // IN, OUT, ADJUSTMENT, RESERVATION
  quantity    Int
  date        DateTime @default(now())
  referenceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String   @id @default(uuid())
  customerId      String
  status          String   // PENDING, RESERVED, PICKING, SHIPPED, DELIVERED, CANCELLED
  priority        String   // HIGH, NORMAL, LOW
  shippingCarrier String?
  expectedDate    DateTime? // For scheduled reservations
  items           OrderItem[]
  reservations    Reservation[]
  shipment        Shipment?
  warehouseId     String? // Optional for now to support existing orders, but should be required
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pickingTasks    PickingTask[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
}

model Reservation {
  id                  String   @id @default(uuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id])
  quantity            Int
  reservationStrategy String   // FIFO, FEFO, LOCATION
  createdAt           DateTime @default(now())
}

model PickingStrategy {
  id          String    @id @default(uuid())
  name        String    // Single, Cluster, Wave, Batch
  rules       String    // JSON
  active      Boolean   @default(true)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, name]) // Unique per warehouse
}

model PickingSession {
  id          String        @id @default(uuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  strategy    String        // BATCH, WAVE, CLUSTER, SINGLE
  status      String        @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  pickerId    String?       // Link to User (optional)
  tasks       PickingTask[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PickingTask {
  id               String         @id @default(uuid())
  sessionId        String
  session          PickingSession @relation(fields: [sessionId], references: [id])
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  sourceLocationId String
  sourceLocation   Location       @relation(fields: [sourceLocationId], references: [id])
  quantity         Int
  pickedQuantity   Int            @default(0)
  status           String         @default("PENDING") // PENDING, PICKED, PARTIALLY_PICKED, FAILED
  exceptionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model ReservationStrategy {
  id     String  @id @default(uuid())
  name   String  @unique // FIFO, FEFO, Location
  rules  String  // JSON
  active Boolean @default(true)
}

model Shipment {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id])
  carrier    String
  trackingId String
  status     String
}

model ComplianceReport {
  id        String   @id @default(uuid())
  type      String   // VAT, SAF-T
  period    String
  data      String // JSON
  createdAt DateTime @default(now())
}

model SalesChannel {
  id     String @id @default(uuid())
  name   String @unique // Tokopedia, Shopee
  apiKey String
}

model LogisticsPartner {
  id        String @id @default(uuid())
  name      String @unique // JNE, SiCepat
  apiConfig String // JSON
}

model InventoryAdjustment {
  id              String          @id @default(uuid())
  locationId      String
  location        Location        @relation(fields: [locationId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  batchId         String?
  batch           InventoryBatch? @relation(fields: [batchId], references: [id])
  countedQuantity Int             @default(0)
  currentQuantity Int             @default(0)
  quantity        Int // Positive = Found, Negative = Lost
  reason          String
  status          String // DRAFT, APPLIED
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ScrapOrder {
  id          String   @id @default(uuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  maxQuantity Int
  active      Boolean  @default(true)
}

model ReorderingRule {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  minQuantity Int
  maxQuantity Int
  active      Boolean  @default(true)
}

model PutawayRule {
  id          String   @id @default(uuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  categoryId  String?  // Optional: Apply to entire category
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  sourceLocationId String? // Optional: Only apply if arriving at this location
  sourceLocation   Location? @relation("PutawaySource", fields: [sourceLocationId], references: [id])
  priority    Int      @default(0)
  active      Boolean  @default(true)
}

// --- Inbound / Purchase Order Models ---

model Supplier {
  id          String   @id @default(uuid())
  name        String   @unique
  contactInfo String?  // JSON or text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  status        String   @default("DRAFT") // DRAFT, ORDERED, RECEIVED, CANCELLED
  expectedDate  DateTime?
  items         PurchaseOrderItem[]
  receipts      Receipt[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Float         @default(0)
  packagingId     String?
  packaging       ProductPackaging? @relation(fields: [packagingId], references: [id])
}

model Receipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  status          String        @default("READY") // READY, DONE
  destinationLocationId String
  destinationLocation Location  @relation(fields: [destinationLocationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model StockMove {
  id                    String   @id @default(uuid())
  productId             String
  product               Product  @relation(fields: [productId], references: [id])
  quantity              Int
  status                String   @default("DRAFT") // DRAFT, WAITING, READY, DONE, CANCELLED
  sourceLocationId      String?
  sourceLocation        Location? @relation("MoveSource", fields: [sourceLocationId], references: [id])
  destinationLocationId String?
  destinationLocation   Location? @relation("MoveDest", fields: [destinationLocationId], references: [id])
  ruleId                String?
  rule                  Rule?    @relation(fields: [ruleId], references: [id])
  origin                String?  // e.g. PO001, MO001
  batchId               String?
  batch                 InventoryBatch? @relation(fields: [batchId], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
