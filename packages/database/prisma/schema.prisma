generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id             String    @id @default(uuid())
  sku            String    @unique
  name           String
  category       String
  classification String? // ABC Classification: A, B, C
  type           String? // Raw, Finished, Semi-finished
  unitOfMeasure  String? // Centimeter, Piece, etc.
  isStockable    Boolean   @default(true)
  status         String    @default("Active")
  averageCost    Float     @default(0)
  price          Float     @default(0)
  description    String?
  tracking       String    @default("none") // none, lot, serial
  expiryDate     DateTime? // Keep for legacy/simple use, but Batches are preferred
  // Dimensions & Weight
  width          Float? // cm
  height         Float? // cm
  depth          Float? // cm
  weight         Float? // kg
  
  // Advanced Warehouse Attributes
  velocity       String?   @default("C") // A, B, C (Fast, Medium, Slow)
  abcClass       String?   // A, B, C (Cost based)

  // ===  PHASE 3: Enhanced Putaway - Storage Requirements - NOW DYNAMIC  ===
  // Removed: storageRequirements String? - replaced by attributes relation (ProductAttribute)
  temperatureMin      Float?  // °C - minimum storage temperature required (kept for direct temp ranges)
  temperatureMax      Float?  // °C - maximum storage temperature required (kept for direct temp ranges)
  
  // === PHASE 2: Enhanced Putaway - Packaging Preferences ===
  preferredPackaging  String? // PALLET, BOX, INDIVIDUAL
  stackable           Boolean @default(true)
  maxStackHeight      Int?    // Maximum number of units to stack

  supplierId           String?
  inventory            ProductInventory[] // Aggregate view
  batches              InventoryBatch[] // Detailed view
  orderItems           OrderItem[]
  reservations         Reservation[]
  transactions         StockTransaction[]
  putawayRules         PutawayRule[]
  inventoryAdjustments InventoryAdjustment[]
  scrapOrders          ScrapOrder[]
  reorderingRules      ReorderingRule[]
  routes               Route[]
  purchaseOrderItems   PurchaseOrderItem[]
  stockMoves           StockMove[]
  packaging            ProductPackaging[]
  pickingTasks         PickingTask[]
  putawayTasks         PutawayTask[]
  TransferOrderItem    TransferOrderItem[]
  receiptItems         ReceiptItem[]

  // Storage
  requiredAttributeId String?
  requiredAttribute   LocationAttributeDefinition? @relation(fields: [requiredAttributeId], references: [id])
  rotationRules       RotationRule[]
  attributes          ProductAttribute[]
  stocktakeTasks      StocktakeTask[]
}

model Route {
  id          String    @id @default(uuid())
  name        String
  description String?
  rules       Rule[]
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Rule {
  id                    String      @id @default(uuid())
  routeId               String
  route                 Route       @relation(fields: [routeId], references: [id])
  action                String // PULL, PUSH
  sourceLocationId      String?
  sourceLocation        Location?   @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destinationLocationId String?
  destinationLocation   Location?   @relation("DestLocation", fields: [destinationLocationId], references: [id])
  sequence              Int         @default(0)
  stockMoves            StockMove[]
}

model Warehouse {
  id             String    @id @default(uuid())
  name           String
  shortName      String? // Max 5 chars
  status         String  @default("Enabled") // Enabled, Disabled

  // Physical Dimensions (meters)
  length         Float?  @default(0)
  width          Float?  @default(0)
  height         Float?  @default(0)
  
  // Capacity
  maxWeight      Float?  @default(0) // Kg
  
  // Structured Address Fields
  address        String? // Street address
  city           String?
  state          String? // State/Province
  postalCode     String?
  country        String?
  phone          String? // Contact phone for delivery services
  latitude       Float?
  longitude      Float?
  
  companyId      String?
  location       String @default("{}") // JSON: { lat: number, lng: number } - deprecated, use latitude/longitude
  type           String
  partnerId      String?
  viewLocationId String?   @unique
  viewLocation   Location? @relation("WarehouseView", fields: [viewLocationId], references: [id])

  // Route Configuration
  incomingSteps          String? // "1_step", "2_steps", "3_steps"
  outgoingSteps          String? // "1_step", "2_steps", "3_steps"
  dropshipSubcontractors Boolean @default(false)
  resupplySubcontractors Boolean @default(false)
  manufactureToResupply  Boolean @default(false)
  manufactureSteps       String? // "1_step", "2_steps", "3_steps"
  buyToResupply          Boolean @default(false)

  // Floor Plan Configuration
  floorPlanShape     String? @default("rectangle") // "rectangle", "u_shape", "l_shape", "custom"
  floorPlanVertices  String? // JSON array of {x, y} points in meters
  floorPlanWidth     Float?  @default(50.0) // Bounding box width in meters
  floorPlanHeight    Float?  @default(30.0) // Bounding box height in meters
  
  // Grid Settings
  gridEnabled        Boolean @default(true)
  gridSize           Float   @default(1.0) // Grid square size in meters
  snapToGrid         Boolean @default(true)

  inventory          ProductInventory[]
  batches            InventoryBatch[]
  pickingStrategies  PickingStrategy[]
  orders             Order[]
  transferDestOrders Order[]            @relation("OrderDestination")
  pickingSessions    PickingSession[]
  putawaySessions    PutawaySession[]
  putawayRules       PutawayRule[] // Phase 2

  users            User[]
  fulfillmentRules FulfillmentRule[]
  sourceTransfers  TransferOrder[]   @relation("TransferSource")
  destTransfers    TransferOrder[]   @relation("TransferDest")
  rotationRules    RotationRule[]
  functionalAreas  WarehouseFunctionalArea[]
  lalamoveConfig   LalamoveConfig?
  stocktakeSessions StocktakeSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WarehouseFunctionalArea {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  
  // Area Definition
  name        String    // e.g. "Main Receiving Dock"
  areaType    String    // RECEIVING, STAGING, PUTAWAY_LANE, STORAGE, PICKING, PACKING, SHIPPING
  
  // Floor Plan Coordinates
  x           Float     @default(0)
  y           Float     @default(0)
  width       Float     @default(100)
  height      Float     @default(100)
  rotation    Float     @default(0)
  
  // Visual Properties
  color       String?   // Hex color for visualization
  icon        String?   // Icon identifier
  
  // Configuration
  attributes  String?   // JSON: { capacity, equipment, etc. }
  active      Boolean   @default(true)
  sequence    Int       @default(0) // Order in process flow
  
  // Linking
  linkedLocationId String?
  linkedLocation   Location? @relation(fields: [linkedLocationId], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Location {
  id                 String    @id @default(uuid())
  name               String
  type               String // VIEW, INTERNAL, VENDOR, CUSTOMER, INVENTORY_LOSS, PRODUCTION, TRANSIT
  structuralType     String? // WAREHOUSE, ROOM, ROW, BAY, SHELF, POSITION
  attributes         String? // JSON: { temperature: 'refrigerated', loadBearing: true, ... }
  supportedPackaging String? // JSON: ["PALLET", "BOX"]
  removalStrategy    String? // FIFO, LIFO, FEFO
  inventoryFrequency Int       @default(0) // Days
  nextInventoryDate  DateTime?

  // Capacity (Updated Phase 8)
  maxVolume Float? // m3 (Legacy, consider deprecating for computed)
  maxWeight Float? // DEPRECATED: Use maxWeightKg instead. Kept for legacy compatibility.
  
  // Canonical Physical Dimensions (Phase 8)
  innerLength Float?    @default(0) // mm
  innerWidth  Float?    @default(0) // mm
  innerHeight Float?    @default(0) // mm
  maxWeightKg Float?    @default(0) // kg (Canonical source of truth)

  // Naming & Addressing (Phase 8)
  code        String?   // Short code, e.g. "RCV". Unique per parent.
  fullAddress String?   @unique // Materialized path: "WH01.RCV.01"

  // Floor Plan Coordinates (for Bays)
  x        Float? @default(0)
  y        Float? @default(0)
  width    Float? @default(1)
  height   Float? @default(1)
  rotation Float? @default(0)

  // Optimization
  zonePriority   Int       @default(100) // Lower = Higher Priority (e.g. 1 = Golden Zone, 100 = Back of house)
  putawaySequence Int      @default(0)   // Order to traverse within the zone

  parentId      String?
  parent        Location?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children      Location[] @relation("LocationHierarchy")
  warehouseId   String?
  warehouseView Warehouse? @relation("WarehouseView")

  // Relations
  inventory          ProductInventory[]
  batches            InventoryBatch[]
  adjustments        InventoryAdjustment[]
  scrapOrders        ScrapOrder[]
  putawayRules       PutawayRule[]
  sourcePutawayRules PutawayRule[]         @relation("PutawaySource")
  putawayDestinationRules PutawayRule[]    @relation("PutawayDest") // Phase 2
  reorderingRules    ReorderingRule[]
  sourceRules        Rule[]                @relation("SourceLocation")
  destRules          Rule[]                @relation("DestLocation")
  packages           Package[]
  receipts           Receipt[]
  sourceMoves        StockMove[]           @relation("MoveSource")
  destMoves          StockMove[]           @relation("MoveDest")
  pickingTasks       PickingTask[]
  putawaySourceTasks PutawayTask[]         @relation("PutawaySource")
  putawayDestTasks   PutawayTask[]         @relation("PutawayDest")
  functionalAreas    WarehouseFunctionalArea[]
  
  // Phase 3B: Dynamic attributes (replacing JSON)
  dynamicAttributes  LocationAttribute[]
  stocktakeTasks     StocktakeTask[]
}

model ProductPackaging {
  id       String @id @default(uuid())
  name     String // e.g. "Box of 12", "Pallet"
  unitType String @default("UNIT") // INDIVIDUAL, BOX, PALLET
  quantity Int    @default(1)

  // Dimensions & Weight
  width  Float @default(0) // cm
  height Float @default(0) // cm
  length Float @default(0) // cm matches depth
  weight Float @default(0) // kg

  // Ti-Hi Logic (Palletization)
  ti     Int   @default(0) // Tier (Cartons per layer)
  hi     Int   @default(0) // High (Layers per pallet)

  barcode String?

  storageRequirements String? // JSON: ["refrigerated", "heavy_duty"]
  maxStacking         Int     @default(1)

  packages           Package[]
  purchaseOrderItems PurchaseOrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  Product            Product?            @relation(fields: [productId], references: [id])
  productId          String?
}

// Aggregate Inventory (Legacy/Fast Lookup)
model ProductInventory {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  quantity    Int
  reserved    Int       @default(0)
}

model InventoryBatch {
  id              String                @id @default(uuid())
  batchNumber     String                @unique
  productId       String
  product         Product               @relation(fields: [productId], references: [id])
  warehouseId     String
  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id])
  locationId      String?
  location        Location?             @relation(fields: [locationId], references: [id])
  packageId       String?
  package         Package?              @relation(fields: [packageId], references: [id])
  initialQuantity Int
  currentQuantity Int
  reserved        Int       @default(0)
  costPerUnit     Float
  purchaseDate    DateTime
  expiryDate      DateTime?
  status          String // Active, Expired, Depleted
  vendor          String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  adjustments     InventoryAdjustment[]
  stockMoves      StockMove[]
}

model Package {
  id          String            @id @default(uuid())
  name        String            @unique // Barcode / LPN
  type        String // Box, Pallet, etc. (Legacy/Simple)
  
  // Canonical Handling Unit Properties (Phase 8)
  huType      String    @default("BOX") // PALLET, BOX, EACH
  outerLength Float?    @default(0) // mm
  outerWidth  Float?    @default(0) // mm
  outerHeight Float?    @default(0) // mm
  tareWeight  Float?    @default(0) // kg

  packagingId String?
  packaging   ProductPackaging? @relation(fields: [packagingId], references: [id])
  locationId  String?
  location    Location?         @relation(fields: [locationId], references: [id])
  batches     InventoryBatch[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model StockTransaction {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  batchId     String?
  type        String // IN, OUT, ADJUSTMENT, RESERVATION
  quantity    Int
  date        DateTime @default(now())
  referenceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id                String          @id @default(uuid())
  customerId        String?
  customer          Customer?       @relation(fields: [customerId], references: [id]) // Optional for migration safety
  status            String // PENDING, RESERVED, PICKING, SHIPPED, DELIVERED, CANCELLED
  fulfillmentStatus String          @default("UNALLOCATED") // UNALLOCATED, ALLOCATED, PARTIAL
  priority          String // HIGH, NORMAL, LOW
  shippingCarrier   String?
  expectedDate      DateTime? // For scheduled reservations
  items             OrderItem[]
  reservations      Reservation[]
  shipment          Shipment?
  warehouseId       String? // Optional for now to support existing orders, but should be required
  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  totalAmount       Float           @default(0)
  pickingTasks      PickingTask[]
  transferOrders    TransferOrder[]

  // Unified Order Fields
  type                   String     @default("SALES") // SALES, TRANSFER
  destinationWarehouseId String?
  destinationWarehouse   Warehouse? @relation("OrderDestination", fields: [destinationWarehouseId], references: [id])
  parentOrderId          String?
  parentOrder            Order?     @relation("OrderHierarchy", fields: [parentOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childOrders            Order[]    @relation("OrderHierarchy")

  // Shipping Logic
  deliveryMethodId   String?
  deliveryMethod     DeliveryMethod? @relation(fields: [deliveryMethodId], references: [id])
  shippingCost       Float           @default(0)
  shippingCostInCOGS Boolean         @default(false)
  
  // Lalamove Integration
  lalamoveOrders LalamoveOrder[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  // RMA Fields
  returnReason String? // Defective, Wrong Item, etc.
  condition    String? // Sellable, Damaged, etc.
}

model Reservation {
  id                  String   @id @default(uuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id])
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id])
  quantity            Int
  reservationStrategy String // FIFO, FEFO, LOCATION
  createdAt           DateTime @default(now())
}

model PickingStrategy {
  id          String     @id @default(uuid())
  name        String // Single, Cluster, Wave, Batch
  rules       String // JSON
  active      Boolean    @default(true)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, name]) // Unique per warehouse
}

model PickingSession {
  id          String        @id @default(uuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  strategy    String // BATCH, WAVE, CLUSTER, SINGLE
  status      String        @default("PLANNED") // PLANNED, ASSIGNED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  pickerId    String? // Link to User (optional)
  picker      User?         @relation(fields: [pickerId], references: [id])
  tasks       PickingTask[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}


model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LocationAttributeDefinition {
  id        String    @id @default(uuid())
  name      String    @unique
  type      String // SELECT, TEXT, NUMBER, BOOLEAN
  options   String? // JSON array for SELECT options
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Product   Product[]
  
  // Reverse relations for dynamic attributes
  putawayRuleAttributes  PutawayRuleAttribute[] @relation("PutawayRuleAttributes")
  productAttributes      ProductAttribute[]      @relation("ProductAttributes")
  locationAttributes     LocationAttribute[]     @relation("LocationAttributes")
}

model PickingTask {
  id               String         @id @default(uuid())
  sessionId        String
  session          PickingSession @relation(fields: [sessionId], references: [id])
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  sourceLocationId String
  sourceLocation   Location       @relation(fields: [sourceLocationId], references: [id])
  quantity         Int
  pickedQuantity   Int            @default(0)
  status           String         @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, PICKED, BLOCKED, FAILED
  exceptionReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model PutawaySession {
  id          String        @id @default(uuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  status      String        @default("PLANNED") // PLANNED, ASSIGNED, IN_PROGRESS, ON_HOLD, COMPLETED, CANCELLED
  workerId    String?       // Link to User (optional)
  worker      User?         @relation(fields: [workerId], references: [id])
  tasks       PutawayTask[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model PutawayTask {
  id                    String          @id @default(uuid())
  sessionId             String?
  session               PutawaySession? @relation(fields: [sessionId], references: [id])
  receiptId             String?
  receipt               Receipt?        @relation(fields: [receiptId], references: [id])
  productId             String
  product               Product        @relation(fields: [productId], references: [id])
  sourceLocationId      String         // Receiving/Staging location
  sourceLocation        Location       @relation("PutawaySource", fields: [sourceLocationId], references: [id])
  destinationLocationId String         // Recommended storage location
  destinationLocation   Location       @relation("PutawayDest", fields: [destinationLocationId], references: [id])
  quantity              Int
  putawayQuantity       Int            @default(0)
  status                String         @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, COMPLETED, BLOCKED, FAILED
  
  // Exception tracking
  exceptionType             String?  // LOCATION_FULL, DAMAGED, SHORT_RECEIPT, OVERAGE, WRONG_PRODUCT, OTHER
  exceptionReason           String?  // Detailed description
  originalQuantity          Int?     // Track original before adjustments
  actualQuantity            Int?     // Actual quantity if different
  alternativeLocationId     String?  // If redirected
  requiresSupervisorReview  Boolean  @default(false)
  resolvedBy                String?  // User ID who resolved
  resolvedAt                DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model ReservationStrategy {
  id     String  @id @default(uuid())
  name   String  @unique // FIFO, FEFO, Location
  rules  String // JSON
  active Boolean @default(true)
}

model Shipment {
  id         String @id @default(uuid())
  orderId    String @unique
  order      Order  @relation(fields: [orderId], references: [id])
  carrier    String
  trackingId String
  status     String
}

model ComplianceReport {
  id        String   @id @default(uuid())
  type      String // VAT, SAF-T
  period    String
  data      String // JSON
  createdAt DateTime @default(now())
}

model SalesChannel {
  id     String @id @default(uuid())
  name   String @unique // Tokopedia, Shopee
  apiKey String
}

model LogisticsPartner {
  id        String @id @default(uuid())
  name      String @unique // JNE, SiCepat
  apiConfig String // JSON
}

model InventoryAdjustment {
  id              String          @id @default(uuid())
  locationId      String
  location        Location        @relation(fields: [locationId], references: [id])
  productId       String
  product         Product         @relation(fields: [productId], references: [id])
  batchId         String?
  batch           InventoryBatch? @relation(fields: [batchId], references: [id])
  countedQuantity Int             @default(0)
  currentQuantity Int             @default(0)
  quantity        Int // Positive = Found, Negative = Lost
  reason          String
  status          String // DRAFT, APPLIED
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ScrapOrder {
  id          String   @id @default(uuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  maxQuantity Int
  active      Boolean  @default(true)
}

model ReorderingRule {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  minQuantity Int
  maxQuantity Int
  active      Boolean  @default(true)
}

model PutawayRule {
  id               String    @id @default(uuid())
  name             String    // Human-readable rule name
  description      String?
  
  // =========================
  // MATCHING CRITERIA (What products/scenarios this rule applies to)
  // =========================
  
  // Product Filters
  productId        String?
  product          Product?  @relation(fields: [productId], references: [id])
  categoryId       String?   // Optional: Apply to entire category
  
  // === PHASE 2: Velocity & Classification Matching ===
  velocityClass    String?   // A, B, C (fast/medium/slow moving)
  abcClass         String?   // A, B, C (cost-based classification)
  
  
  // === PHASE 3: Storage Requirements - NOW DYNAMIC via PutawayRuleAttribute ===
  // Removed: requiredAttributes String? - replaced by requiredAttributes relation
  // Removed: temperatureMin/Max - can be implemented via LocationAttribute if needed
  
  
  // === PHASE 2: Packaging Size Filtering ===
  minPackagingSize String?   // INDIVIDUAL, BOX, PALLET
  maxPackagingSize String?
  
  // === PHASE 2: Weight Filtering ===
  minWeight        Float?    // kg - rule applies if total weight >= this
  maxWeight        Float?    // kg - rule applies if total weight <= this
  
  // Source Location Filter
  sourceLocationId String?   // Only apply if coming from this location
  sourceLocation   Location? @relation("PutawaySource", fields: [sourceLocationId], references: [id])
  
  // =========================
  // DESTINATION STRATEGY (How to select target location)
  // =========================
  
  // === PHASE 2: Selection Strategy ===
  strategy         String    // FIXED, ZONE_PRIORITY, CLOSEST, LEAST_OCCUPIED, BALANCED
  
  // For FIXED strategy
  destinationLocationId String?
  destinationLocation   Location? @relation("PutawayDest", fields: [destinationLocationId], references: [id])
  
  // For ZONE_PRIORITY strategy
  preferredZonePriorityMin Int?  // e.g., 1 (golden zone)
  preferredZonePriorityMax Int?  // e.g., 20
  
  // Warehouse Scoping
  warehouseId      String?   // Rule applies only to this warehouse (null = all warehouses)
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  
  // Legacy field (keeping for backwards compatibility)
  locationId       String?   // Old field - use destinationLocationId instead
  location         Location?  @relation(fields: [locationId], references: [id])
  
  // Rule Metadata
  priority         Int       @default(0)  // Higher = checked first
  active           Boolean   @default(true)
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Relations
  requiredAttributes PutawayRuleAttribute[]
}

model PutawayRuleAttribute {
  id                      String                      @id @default(uuid())
  putawayRuleId          String
  putawayRule            PutawayRule                 @relation(fields: [putawayRuleId], references: [id], onDelete: Cascade)
  
  attributeDefinitionId  String
  attributeDefinition    LocationAttributeDefinition @relation("PutawayRuleAttributes", fields: [attributeDefinitionId], references: [id])
  
  requiredValue          String?  // For boolean: "true", for select: specific option
  
  createdAt              DateTime @default(now())
  
  @@unique([putawayRuleId, attributeDefinitionId])
}

model ProductAttribute {
  id                      String                      @id @default(uuid())
  productId              String
  product                Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  attributeDefinitionId  String
  attributeDefinition    LocationAttributeDefinition @relation("ProductAttributes", fields: [attributeDefinitionId], references: [id])
  
  value                  String?  // Attribute value (for select types, or "true" for boolean)
  
  createdAt              DateTime @default(now())
  
  @@unique([productId, attributeDefinitionId])
}

model LocationAttribute {
  id                      String                      @id @default(uuid())
  locationId             String
  location               Location                    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  definitionId           String
  definition             LocationAttributeDefinition @relation("LocationAttributes", fields: [definitionId], references: [id])
  
  value                  String?  // For future extensibility (temperature values, etc.)
  
  createdAt              DateTime @default(now())
  
  @@unique([locationId, definitionId])
}

// --- Inbound / Purchase Order Models ---

model Supplier {
  id             String          @id @default(uuid())
  name           String          @unique
  contactInfo    String? // JSON or text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
}

model PurchaseOrder {
  id              String    @id @default(uuid())
  poNumber        String    @unique @default(cuid()) // Temporary default to avoid migration issues
  supplierId      String
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  status          String    @default("DRAFT") // DRAFT, ORDERED, RECEIVED, CANCELLED
  approvalStatus  String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?

  orderDate    DateTime  @default(now())
  expectedDate DateTime?

  // Header Info
  buyerName    String?
  buyerAddress String?
  buyerContact String?

  shipToAddress String?
  billToAddress String?

  // Financials
  taxAmount    Float @default(0)
  shippingCost Float @default(0)
  totalAmount  Float @default(0)

  // Footer Info
  paymentTerms  String?
  deliveryTerms String?
  notes         String?

  items     PurchaseOrderItem[]
  receipts  Receipt[]
  invoices  Invoice[]
  transfers TransferOrder[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model PurchaseOrderItem {
  id              String            @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product           @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Float             @default(0)
  packagingId     String?
  packaging       ProductPackaging? @relation(fields: [packagingId], references: [id])
  receiptItems    ReceiptItem[]
}

model Receipt {
  id                    String        @id @default(uuid())
  purchaseOrderId       String
  purchaseOrder         PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  status                String        @default("DONE") // DONE, CANCELLED
  receivedAt            DateTime      @default(now())
  destinationLocationId String
  destinationLocation   Location      @relation(fields: [destinationLocationId], references: [id])

  items        ReceiptItem[]
  putawayTasks PutawayTask[]

  // Link to Invoice (optional, for 3-way match)
  invoiceId String?
  // invoice      Invoice? ...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReceiptItem {
  id        String  @id @default(uuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int // Quantity received in this specific receipt

  // Link to PO Item for tracking
  poItemId String
  poItem   PurchaseOrderItem @relation(fields: [poItemId], references: [id])
}

model Invoice {
  id              String         @id @default(uuid())
  invoiceNumber   String // Vendor's invoice #
  vendorId        String
  vendor          Supplier       @relation(fields: [vendorId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  status      String   @default("DRAFT") // DRAFT, POSTED, PAID, CANCELLED
  totalAmount Float
  issueDate   DateTime
  dueDate     DateTime

  items     InvoiceItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  productId   String?
  description String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  // 3-Way Match Links
  poItemId      String?
  receiptItemId String?
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String? // Hashed password
  name     String

  roles      Role[]
  warehouses Warehouse[]

  initiatedTransfers TransferOrder[]  @relation("TransferInitiator")
  approvedTransfers  TransferOrder[]  @relation("TransferApprover")
  pickingSessions    PickingSession[]
  putawaySessions    PutawaySession[]
  apiKeys            ApiKey[]
}

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  description String?
  keyHash     String    @unique
  scopes      String    // JSON array of permission strings, e.g. ["INVENTORY:READ", "ORDERS:CREATE"]
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  
  // Structured Address Fields
  address   String? // Street address
  city      String?
  state     String? // State/Province
  postalCode String?
  country   String?
  latitude  Float?
  longitude Float?
  phone     String? // Contact phone for delivery services
  
  orders    Order[]
  rotationRules RotationRule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FulfillmentRule {
  id          String     @id @default(uuid())
  name        String
  priority    Int        @default(0)
  strategy    String // PRIMARY, HIGHEST_STOCK, CLOSEST
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // Logic Config
  actionIfUnavailable String  @default("NEXT_RULE") // NEXT_RULE, TRIGGER_TRANSFER, BACKORDER
  transferSourceRule  String? // JSON: { "strategy": "CLOSEST" } or { "warehouseId": "abc" }

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransferOrder {
  id                     String    @id @default(uuid())
  sourceWarehouseId      String
  sourceWarehouse        Warehouse @relation("TransferSource", fields: [sourceWarehouseId], references: [id])
  destinationWarehouseId String
  destinationWarehouse   Warehouse @relation("TransferDest", fields: [destinationWarehouseId], references: [id])

  status String @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, PROCESSING, DONE, CANCELLED

  initiatorId String
  initiator   User   @relation("TransferInitiator", fields: [initiatorId], references: [id])

  approverId String?
  approver   User?   @relation("TransferApprover", fields: [approverId], references: [id])

  items TransferOrderItem[]

  // Multi-Step Layout
  type           String    @default("INTERNAL") // INBOUND_FLOW, OUTBOUND_FLOW, INTERNAL
  totalSteps     Int       @default(1)
  currentStep    Int       @default(1)
  activeMoveId   String?   // Pointer to current active move

  moves          StockMove[]

  relatedOrderId String?
  relatedOrder   Order?  @relation(fields: [relatedOrderId], references: [id])
  
  // Link to PO
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TransferOrderItem {
  id               String        @id @default(uuid())
  transferOrderId  String
  transferOrder    TransferOrder @relation(fields: [transferOrderId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Int
  receivedQuantity Int           @default(0)
}

// --- Existing Models Updates ---

model StockMove {
  id                    String          @id @default(uuid())
  productId             String
  product               Product         @relation(fields: [productId], references: [id])
  quantity              Int
  status                String          @default("DRAFT") // DRAFT, WAITING, READY, IN_PROGRESS, DONE, CANCELLED, FAILED
  sourceLocationId      String?
  sourceLocation        Location?       @relation("MoveSource", fields: [sourceLocationId], references: [id])
  destinationLocationId String?
  destinationLocation   Location?       @relation("MoveDest", fields: [destinationLocationId], references: [id])
  ruleId                String?
  rule                  Rule?           @relation(fields: [ruleId], references: [id])
  origin                String? // e.g. PO001, MO001
  batchId               String?
  batch                 InventoryBatch? @relation(fields: [batchId], references: [id])
  
  // Chaining & Multi-Step
  sequence        Int      @default(0)
  transferOrderId String?
  transferOrder   TransferOrder? @relation(fields: [transferOrderId], references: [id])
  
  nextMoveId      String?  @unique
  nextMove        StockMove? @relation("ChainedMoves", fields: [nextMoveId], references: [id])
  previousMove    StockMove? @relation("ChainedMoves")

  // Exception Tracking
  inputQuantity   Int?     // Expected
  outputQuantity  Int?     // Actual
  exceptionReason String?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // e.g., "Warehouse Manager", "Picker"
  description String?
  isSystem    Boolean      @default(false) // System roles cannot be deleted
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DeliveryMethod {
  id         String  @id @default(uuid())
  name       String
  active     Boolean @default(true)
  provider   String // FIXED_PRICE, BASED_ON_RULES, LALAMOVE
  fixedPrice Float   @default(0)

  // Link to external carrier (optional integration)
  carrier String? // FedEx, UPS, Lalamove, etc.

  rules  ShippingRule[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LalamoveConfig {
  id            String    @id @default(uuid())
  warehouseId   String    @unique
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  
  market        String   // TH, SG, HK, PH, MY, ID, TW, VN, BR, MX, JP
  apiKey        String   // Encrypted
  apiSecret     String   // Encrypted
  environment   String   @default("SANDBOX") // SANDBOX, PRODUCTION
  webhookUrl    String?
  
  defaultServiceType String? // MOTORCYCLE, SEDAN, VAN, LORRY
  
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([warehouseId])
}

model LalamoveOrder {
  id              String    @id @default(uuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Lalamove identifiers
  quotationId     String?
  lalamoveOrderId String?   @unique
  shareLink       String?
  
  // Order details
  serviceType     String    // MOTORCYCLE, SEDAN, VAN, LORRY
  market          String
  status          String    // ASSIGNING_DRIVER, ON_GOING, PICKED_UP, COMPLETED, CANCELLED, REJECTED, EXPIRED
  
  // Pricing
  quotedPrice     Float?
  finalPrice      Float?
  currency        String?
  priceBreakdown  String?   // JSON
  
  // Driver info
  driverId        String?
  driverName      String?
  driverPhone     String?
  driverPlate     String?
  
  // Tracking
  distance        Float?    // in meters
  distanceUnit    String?   // m, km
  
  // Stops (JSON array)
  stops           String    // JSON: [{address, coordinates, name, phone, status, POD}]
  
  // Metadata
  specialRequests String?   // JSON array
  remarks         String?   // JSON array
  metadata        String?   // JSON key-value pairs
  
  // Proof of delivery
  podStatus       String?   // PENDING, DELIVERED, FAILED
  podImageUrl     String?
  deliveredAt     DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([orderId])
  @@index([lalamoveOrderId])
}

model ShippingRule {
  id               String         @id @default(uuid())
  deliveryMethodId String
  deliveryMethod   DeliveryMethod @relation(fields: [deliveryMethodId], references: [id])

  // Conditions (Null means no limit)
  minWeight Float?
  maxWeight Float?
  minVolume Float?
  maxVolume Float?
  minPrice  Float?
  maxPrice  Float?

  // Cost
  price Float

  sequence Int @default(0) // Evaluation order
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource  String // e.g., "INVENTORY", "ORDERS", "PURCHASE_ORDERS"
  action    String // CREATE, READ, UPDATE, DELETE, APPROVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, resource, action])
}

model RotationRule {
  id               String     @id @default(uuid())
  priority         Int        @default(0) // Higher number = higher priority
  
  // Scope Scenarios (Nullable)
  customerId       String?
  customer         Customer?  @relation(fields: [customerId], references: [id])
  orderTypeId      String?    // e.g. "B2B", "ECOM"
  productId        String?    // SKU level
  product          Product?   @relation(fields: [productId], references: [id])
  categoryId       String?    // Product Category (String match)
  warehouseId      String?    // Default level
  warehouse        Warehouse? @relation(fields: [warehouseId], references: [id])
  
  // Policy Config
  policy           String     // FIFO, FEFO, LIFO
  minShelfLifeDays Int?       // FEFO constraint
  missingExpiryAction String? // FALLBACK_FIFO, BLOCK, ALLOW
  
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// --- Stocktaking Models ---

model StocktakeSession {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  status      String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  type        String    // FULL, CYCLE_COUNT, SPOT_CHECK
  
  description String?
  
  tasks       StocktakeTask[]
  
  createdBy   String?   // User ID
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model StocktakeTask {
  id               String           @id @default(uuid())
  sessionId        String
  session          StocktakeSession @relation(fields: [sessionId], references: [id])
  
  locationId       String
  location         Location         @relation(fields: [locationId], references: [id])
  
  productId        String?          // Nullable if blind counting location without pre-specified product
  product          Product?         @relation(fields: [productId], references: [id])

  systemQuantity   Int              // Expected quantity at start
  countedQuantity  Int?             // Null = Not yet counted
  
  status           String           @default("PENDING") // PENDING, COUNTED, VERIFIED
  
  countedBy        String?          // User ID
  countedAt        DateTime?
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}
