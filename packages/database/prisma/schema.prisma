// ─── WORKFLOW DEFINITIONS ───
model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  version     Int      @default(1)
  status      String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  triggerType String   @default("MANUAL") // MANUAL | INBOUND | OUTBOUND | REPLENISHMENT | RETURN
  warehouseId String?
  config      String   @default("{}") // Canvas layout, UI metadata, using String for SQLite JSON fallback if needed. Let's use String since SQLite JSON support in Prisma expects String if provider is sqlite
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  warehouse   Warehouse?           @relation(fields: [warehouseId], references: [id])
  steps       WorkflowStep[]
  transitions WorkflowTransition[]
  instances   WorkflowInstance[]

  @@unique([name, version])
}

model WorkflowStep {
  id         String  @id @default(uuid())
  templateId String
  type       String // RECEIVE | CROSS_DOCK | PUTAWAY | QC_INSPECT | CYCLE_COUNT
  // | WAVE_PICK | BATCH_PICK | ZONE_PICK | WAVELESS_PICK
  // | CONSOLIDATE | STAGE | PACK | SHIP | RETURN
  // | REPLENISH | CONDITION | SLOTTING | CUSTOM
  name               String
  config             String  @default("{}") // Step-specific params
  positionX          Float   @default(0) // Canvas position
  positionY          Float   @default(0)
  isStart            Boolean @default(false)
  isEnd              Boolean @default(false)
  order              Int     @default(0)
  slaDurationMinutes  Int?    // If set, tasks for this step get dueAt = now() + slaDurationMinutes
  maxRetries          Int     @default(0)  // Number of automatic retries on task failure (0 = no retries)
  retryBackoffSeconds Int     @default(30) // Base delay in seconds; doubles per attempt (exponential backoff)
  parallelGroup       String? // Steps sharing this key fan out simultaneously; engine joins when all complete

  template        WorkflowTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fromTransitions WorkflowTransition[]   @relation("FromStep")
  toTransitions   WorkflowTransition[]   @relation("ToStep")
  taskInstances   WorkflowTaskInstance[]
}

model WorkflowTransition {
  id         String  @id @default(uuid())
  templateId String
  fromStepId String
  toStepId   String
  condition  String? @default("{}") // JSON string
  label      String? // "Yes" / "No" / "Pass" / "Fail"
  order      Int     @default(0)

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fromStep WorkflowStep     @relation("FromStep", fields: [fromStepId], references: [id], onDelete: Cascade)
  toStep   WorkflowStep     @relation("ToStep", fields: [toStepId], references: [id], onDelete: Cascade)
}

// ─── WORKFLOW EXECUTION ───
model WorkflowInstance {
  id            String    @id @default(uuid())
  templateId    String
  warehouseId   String
  triggerRef    String? // orderId, poId, etc.
  triggerType   String? // ORDER | PO | REPLENISHMENT | RETURN
  status        String    @default("RUNNING") // RUNNING | PAUSED | COMPLETED | FAILED | CANCELLED
  currentStepId String?
  context       String    @default("{}") // Runtime data bag encoded as JSON string
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  pausedBy      String?

  template  WorkflowTemplate       @relation(fields: [templateId], references: [id])
  warehouse Warehouse              @relation(fields: [warehouseId], references: [id])
  tasks     WorkflowTaskInstance[]
  auditLogs WorkflowAuditLog[]
}

model WorkflowTaskInstance {
  id           String    @id @default(uuid())
  instanceId   String
  stepId       String
  assigneeId   String?
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | FAILED | SKIPPED
  input        String?   @default("{}")
  output       String?   @default("{}")
  startedAt    DateTime?
  completedAt  DateTime?
  dueAt        DateTime? // SLA deadline — set at task creation from step.slaDurationMinutes
  retryCount   Int       @default(0) // Number of retry attempts made so far
  retryAfter   DateTime? // Earliest time this task is eligible for re-execution after a failure
  errorMessage String?

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  step     WorkflowStep     @relation(fields: [stepId], references: [id])
  assignee User?            @relation(fields: [assigneeId], references: [id])
}

model WorkflowAuditLog {
  id         String   @id @default(uuid())
  instanceId String
  action     String // STEP_COMPLETED | STEP_FAILED | PAUSED | RESUMED | OVERRIDE | REASSIGNED
  stepId     String?
  userId     String?
  details    String?  @default("{}")
  timestamp  DateTime @default(now())

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

